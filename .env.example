# Copy to .env and fill in (`make init_env`). Gitignored.
# The Atlassian MCP server (@xuandev/atlassian-mcp) is launched through dotenvx,
# which injects this file — keep it to plain KEY=VALUE lines.

# Atlassian Cloud hostname, without https:// and without /wiki
ATLASSIAN_DOMAIN=your-site.atlassian.net

# Your Atlassian Cloud account email
ATLASSIAN_EMAIL=you@example.com

# Create at https://id.atlassian.com/manage-profile/security/api-tokens
ATLASSIAN_API_TOKEN=

