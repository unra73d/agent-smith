{
    "$schema": "https://opencode.ai/config.json",
    "mcp": {
        "ai-dlc-marketplace": {
            "type": "remote",
            "url": "http://localhost:8091/mcp",
            "enabled": true
        },
        "atlassian": {
            "type": "local",
            "enabled": true,
            "command": [
                "npx",
                "-y",
                "@dotenvx/dotenvx",
                "run",
                "--env-file=.env",
                "--",
                "npx",
                "-y",
                "@xuandev/atlassian-mcp"
            ]
        }
    }
}