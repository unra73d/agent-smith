{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "enableAllProjectMcpServers": true,
  "permissions": {
    "allow": [
      "Bash(openspec:*)",
      "Bash(go build:*)",
      "Bash(go vet:*)",
      "Bash(go test:*)",
      "Bash(go fmt:*)",
      "Bash(gofmt:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git branch:*)",
      "Bash(git switch:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(printenv:*)",
      "mcp__atlassian__jira_get_issue",
      "mcp__atlassian__jira_search_issues",
      "mcp__atlassian__jira_get_project_issues",
      "mcp__atlassian__jira_get_epic_issues",
      "mcp__atlassian__jira_get_transitions",
      "mcp__atlassian__jira_get_worklog",
      "mcp__atlassian__jira_batch_get_changelogs",
      "mcp__atlassian__jira_list_projects",
      "mcp__atlassian__jira_search_fields",
      "mcp__atlassian__jira_get_user_profile",
      "mcp__atlassian__confluence_get_page",
      "mcp__atlassian__confluence_get_page_children",
      "mcp__atlassian__confluence_list_pages",
      "mcp__atlassian__confluence_list_spaces",
      "mcp__atlassian__confluence_get_comments",
      "mcp__atlassian__confluence_get_labels",
      "mcp__atlassian__confluence_search"
    ],
    "ask": [
      "Write(openspec/specs/**)",
      "Edit(openspec/specs/**)"
    ],
    "deny": [
      "Bash(claude:*)",
      "Bash(opencode:*)",
      "Bash(make init_spec:*)",
      "Bash(make dev:*)",
      "mcp__atlassian__jira_add_comment",
      "mcp__atlassian__jira_update_issue",
      "mcp__atlassian__jira_create_issue",
      "mcp__atlassian__jira_batch_create_issues",
      "mcp__atlassian__jira_delete_issue",
      "mcp__atlassian__jira_transition_issue",
      "mcp__atlassian__jira_add_worklog",
      "mcp__atlassian__jira_create_issue_link",
      "mcp__atlassian__jira_remove_issue_link",
      "mcp__atlassian__jira_link_to_epic",
      "mcp__atlassian__jira_create_sprint",
      "mcp__atlassian__jira_update_sprint",
      "mcp__atlassian__jira_delete_sprint",
      "mcp__atlassian__jira_move_issues_to_sprint",
      "mcp__atlassian__jira_rank_backlog_issues",
      "mcp__atlassian__jira_create_board",
      "mcp__atlassian__jira_update_board",
      "mcp__atlassian__jira_delete_board",
      "mcp__atlassian__jira_create_version",
      "mcp__atlassian__jira_batch_create_versions",
      "mcp__atlassian__confluence_create_page",
      "mcp__atlassian__confluence_update_page",
      "mcp__atlassian__confluence_delete_page",
      "mcp__atlassian__confluence_add_comment",
      "mcp__atlassian__confluence_add_label"
    ]
  }
}
